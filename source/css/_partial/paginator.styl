.page-nav {
  margin: 0 1.5rem 2.5rem;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem 0.8rem;
  padding-top: 1rem;

  .prev,
  .page-number,
  .next {
    padding: 0.5rem 0;
  }

  .next {
    margin-left: auto;
  }

  a {
    color: #68635c;
    text-decoration: none;
  }
}

@media screen and (max-width: 720px) {
  .page-nav {
    margin-right: 1.25rem;
    margin-left: 1.25rem;
  }
}
